{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "食品安全协同督办图领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CLUE_REGISTERED",
        "HANDOFF_ACCEPTED",
        "SCOPE_RESTRICTED",
        "EVIDENCE_CORRECTED",
        "CASE_CLOSED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "regulated_subject",
        "risk_clue",
        "agency_handoff",
        "enforcement_action"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "CLUE_REGISTERED": [
      "source_type",
      "subject_ref"
    ],
    "HANDOFF_ACCEPTED": [
      "agency_id",
      "due_at"
    ],
    "SCOPE_RESTRICTED": [
      "scope_type",
      "scope_ref"
    ]
  },
  "additionalProperties": false
}
